modules = ["nodejs-20", "postgresql-16"]
run = "npm run build && npm start"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["npm", "start"]

[[ports]]
localPort = 3000
externalPort = 80

[env]
SAMPLE_DOC_URL = "https://docs.google.com/document/d/1iBJmpxa9yOmNk_6sU9aayQzHc-r31p3N7Q5RCfVPBXY/edit"
